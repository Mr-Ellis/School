<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>2.2 · Data Transmission</title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body {
      background: #f0f4fb;
      font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
      color: #1e293b;
      padding: 2rem 1.5rem;
      line-height: 1.7;
      min-height: 100vh;
    }
    .container { max-width: 1100px; margin: 0 auto; }

    .nav {
      background: #0b2a4a;
      padding: 0.9rem 2rem;
      border-radius: 60px;
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 1.8rem;
      margin-bottom: 2.5rem;
      box-shadow: 0 8px 20px rgba(0,20,40,0.08);
    }
    .nav a {
      color: #e6edf5;
      text-decoration: none;
      font-weight: 500;
      font-size: 0.95rem;
      letter-spacing: 0.3px;
      transition: 0.2s;
      display: inline-flex;
      align-items: center;
      gap: 6px;
    }
    .nav a i { font-size: 0.9rem; opacity: 0.7; }
    .nav a:hover { color: #ffffff; text-decoration: underline; text-underline-offset: 4px; }
    .nav .brand { margin-right: auto; font-weight: 600; color: white; font-size: 1.1rem; }
    .nav .brand i { margin-right: 8px; color: #7bb3ff; }

    .back-link {
      display: inline-flex; align-items: center; gap: 6px;
      color: #1f6390; text-decoration: none; font-weight: 500; margin-bottom: 1.5rem;
    }
    .back-link:hover { text-decoration: underline; }

    .page-header { margin-bottom: 2rem; }
    .page-header h1 {
      font-size: 2.4rem; font-weight: 700; color: #0b2a4a;
      display: flex; align-items: center; gap: 12px; flex-wrap: wrap;
    }
    .page-header h1 i { color: #2a6f97; font-size: 2rem; }
    .page-header .sub {
      color: #475569; font-size: 1rem; background: #e9eff8;
      display: inline-block; padding: 0.3rem 1.4rem; border-radius: 40px; margin-top: 0.3rem;
    }

    .lesson-content {
      background: white; border-radius: 24px; padding: 2rem 2.5rem;
      border: 1px solid #e5edf5; box-shadow: 0 4px 14px rgba(0, 20, 40, 0.04);
    }
    .lesson-content h2 {
      font-size: 1.5rem; font-weight: 600; color: #0b2a4a;
      margin: 1.8rem 0 0.8rem 0; border-left: 5px solid #2a6f97; padding-left: 15px;
    }
    .lesson-content h2:first-of-type { margin-top: 0; }
    .lesson-content h3 { font-size: 1.1rem; font-weight: 600; color: #0b2a4a; margin: 1.2rem 0 0.4rem 0; }
    .lesson-content p { margin-bottom: 0.6rem; }
    .lesson-content ul, .lesson-content ol { padding-left: 1.6rem; margin: 0.5rem 0 1rem 0; }
    .lesson-content li { margin-bottom: 0.25rem; }

    .objectives-box {
      background: #eef6fc; border-radius: 16px; padding: 0.8rem 1.4rem;
      margin: 0.5rem 0 1.2rem 0; border-left: 4px solid #2a6f97;
    }
    .objectives-box strong { color: #0b2a4a; }
    .objectives-box ul { margin: 0.2rem 0 0 1.2rem; padding-left: 0.5rem; }
    .objectives-box ul li { list-style-type: disc; font-size: 0.95rem; }

    .highlight-box {
      background: #eef6fc; padding: 1rem 1.6rem; border-radius: 16px;
      border-left: 5px solid #2a6f97; margin: 1rem 0;
    }
    .highlight-box strong { color: #0b2a4a; }
    .highlight-box.green { border-left-color: #4caf50; background: #edf7ed; }
    .highlight-box.amber { border-left-color: #f9a825; background: #fff8e1; }
    .highlight-box.red { border-left-color: #e53935; background: #ffebee; }

    .why-matters-box {
      background: linear-gradient(135deg, #e8f5e9, #c8e6c9);
      border: 2px solid #4caf50; border-radius: 20px;
      padding: 1.4rem 1.8rem; margin: 1.5rem 0;
      display: flex; align-items: flex-start; gap: 1rem;
    }
    .why-matters-box .badge {
      background: #4caf50; color: white; font-weight: 700;
      font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.8px;
      padding: 0.3rem 0.9rem; border-radius: 30px; white-space: nowrap; flex-shrink: 0;
    }
    .why-matters-box h3 { margin-top: 0; color: #1b5e20; font-size: 1.15rem; }
    .why-matters-box p { margin-bottom: 0.3rem; color: #1b5e20; }

    .starter-callout {
      background: linear-gradient(135deg, #fff3e0, #ffe0b2);
      border: 2px solid #e65100; border-radius: 20px;
      padding: 1.4rem 1.8rem; margin: 1.5rem 0;
      display: flex; align-items: flex-start; gap: 1rem;
    }
    .starter-callout .badge {
      background: #e65100; color: white; font-weight: 700;
      font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.8px;
      padding: 0.3rem 0.9rem; border-radius: 30px; white-space: nowrap; flex-shrink: 0;
    }
    .starter-callout h3 { margin-top: 0; color: #7a3300; font-size: 1.15rem; }
    .starter-callout p { margin-bottom: 0.3rem; color: #5a2900; }
    .starter-callout a { color: #e65100; font-weight: 600; text-decoration: none; border-bottom: 2px solid #e65100; }

    .main-task {
      background: linear-gradient(135deg, #fff8e1, #ffecb3);
      border: 2px solid #f9a825; border-radius: 20px;
      padding: 1.4rem 1.8rem; margin: 1.5rem 0;
      display: flex; align-items: flex-start; gap: 1rem;
      flex-wrap: wrap;
    }
    .main-task .badge {
      background: #f9a825; color: #4a2c00; font-weight: 700;
      font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.8px;
      padding: 0.3rem 0.9rem; border-radius: 30px; white-space: nowrap; flex-shrink: 0;
    }
    .main-task h3 { margin-top: 0; color: #7a4b00; font-size: 1.15rem; }
    .main-task p { margin-bottom: 0.3rem; color: #5a3a00; }
    .main-task a {
      color: #e65100; font-weight: 600; text-decoration: none;
      border-bottom: 2px solid #e65100;
    }
    .main-task a:hover { color: #7a3300; }

    .stop-check {
      background: linear-gradient(135deg, #fff3e0, #ffe0b2);
      border: 2px dashed #e65100; border-radius: 16px;
      padding: 1rem 1.4rem; margin: 1.2rem 0;
      display: flex; align-items: flex-start; gap: 0.8rem;
      flex-wrap: wrap;
    }
    .stop-check .badge {
      background: #e65100; color: white; font-weight: 700;
      font-size: 0.65rem; text-transform: uppercase; letter-spacing: 0.8px;
      padding: 0.25rem 0.8rem; border-radius: 30px; white-space: nowrap; flex-shrink: 0;
    }
    .stop-check p { margin: 0; color: #7a3300; font-size: 0.9rem; }
    .stop-check strong { color: #7a3300; }
    .stop-check .wheel-btn {
      background: #e65100; color: white; border: none;
      padding: 0.5rem 1.2rem; border-radius: 30px;
      font-weight: 700; font-size: 0.8rem; cursor: pointer;
      transition: 0.2s; display: inline-flex; align-items: center; gap: 6px;
    }
    .stop-check .wheel-btn:hover { background: #b33f00; }
    .stop-check .unlock-row {
      margin-top: 0.5rem;
      display: flex;
      gap: 0.5rem;
      align-items: center;
      flex-wrap: wrap;
      width: 100%;
    }
    .stop-check .unlock-row input {
      padding: 0.35rem 0.7rem;
      border: 2px solid #e65100;
      border-radius: 8px;
      font-size: 0.8rem;
      width: 130px;
      font-family: 'JetBrains Mono', monospace;
    }
    .stop-check .unlock-row input:focus {
      outline: none;
      border-color: #b33f00;
    }
    .stop-check .unlock-row button {
      background: #0b2a4a;
      color: white;
      border: none;
      padding: 0.35rem 0.9rem;
      border-radius: 30px;
      font-weight: 600;
      font-size: 0.75rem;
      cursor: pointer;
    }
    .stop-check .unlock-row button:hover { background: #1f6390; }
    .stop-check .unlock-row .unlock-msg {
      font-size: 0.75rem;
      font-weight: 600;
    }
    .stop-check .unlock-row .unlock-msg.ok { color: #2d8f2d; }
    .stop-check .unlock-row .unlock-msg.no { color: #b71c1c; }
    .stop-check .teacher-answer {
      display: none;
      margin-top: 0.6rem;
      padding: 0.7rem 1rem;
      background: #fff8e1;
      border-left: 4px solid #f9a825;
      border-radius: 10px;
      font-size: 0.85rem;
      color: #5a3a00;
      width: 100%;
    }
    .stop-check .teacher-answer.show { display: block; }

    .difficulty-legend {
      display: flex;
      flex-wrap: wrap;
      gap: 1rem 2rem;
      background: #f1f6fc;
      padding: 0.8rem 1.4rem;
      border-radius: 12px;
      margin: 1rem 0;
      font-size: 0.85rem;
      align-items: center;
    }
    .difficulty-legend strong { color: #0b2a4a; margin-right: 0.5rem; }
    .difficulty-legend .legend-item {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      color: #475569;
    }
    .difficulty-legend .legend-item .stars {
      display: inline-flex;
      gap: 2px;
      font-size: 0.8rem;
    }
    .difficulty-legend .legend-item .stars .star-filled { color: #f9a825; }
    .difficulty-legend .legend-item .stars .star-empty { color: #d4e3f0; }

    .task-panel {
      position: relative; margin: 1.8rem 0; padding: 1.6rem 1.8rem;
      border-radius: 20px; border: 2px solid #e5edf5;
      background: #ffffff; transition: 0.3s;
    }
    .task-panel.locked {
      background: #f8fafc; border-color: #dceaf7; opacity: 0.7;
    }
    .task-panel.locked .task-content {
      pointer-events: none; user-select: none; filter: blur(3px);
    }
    .task-panel.locked::after {
      content: "🔒 Complete the previous task to unlock";
      position: absolute; top: 50%; left: 50%;
      transform: translate(-50%, -50%);
      background: #0b2a4a; color: white;
      padding: 0.8rem 1.6rem; border-radius: 40px;
      font-weight: 600; font-size: 0.85rem; z-index: 10;
      box-shadow: 0 4px 20px rgba(0,20,40,0.2); white-space: nowrap;
    }
    .task-panel .task-header {
      display: flex; align-items: center; justify-content: space-between;
      margin-bottom: 1rem; flex-wrap: wrap; gap: 0.5rem;
    }
    .task-panel .task-header h3 {
      margin: 0; font-size: 1.15rem;
      display: flex; align-items: center; gap: 10px; flex-wrap: wrap;
    }
    .task-panel .task-status {
      font-size: 0.8rem; font-weight: 600;
      padding: 0.3rem 0.9rem; border-radius: 30px;
    }
    .task-panel .task-status.done { background: #e8f5e9; color: #2d8f2d; }
    .task-panel .task-status.pending { background: #fff8e1; color: #b45309; }
    .task-panel .task-status.locked-status { background: #f1f5f9; color: #64748b; }

    .stars {
      display: inline-flex;
      gap: 2px;
      font-size: 0.75rem;
      margin-left: 4px;
    }
    .stars .star-filled { color: #f9a825; }
    .stars .star-empty { color: #d4e3f0; }

    .task-timer {
      background: #0b2a4a; color: white;
      padding: 0.4rem 1rem; border-radius: 30px;
      font-family: 'JetBrains Mono', monospace;
      font-size: 0.9rem; font-weight: 700;
      display: inline-flex; align-items: center; gap: 8px;
      transition: 0.3s; cursor: pointer;
      animation: pulse-timer 1.5s infinite;
    }
    .task-timer:hover { background: #1f6390; animation: none; }
    .task-timer.warning { background: #e65100; animation: none; }
    .task-timer.danger { background: #b71c1c; animation: none; }
    .task-timer i { font-size: 0.8rem; opacity: 0.7; }

    @keyframes pulse-timer {
      0% { transform: scale(1); box-shadow: 0 0 0 0 rgba(11, 42, 74, 0.4); }
      50% { transform: scale(1.05); box-shadow: 0 0 0 8px rgba(11, 42, 74, 0); }
      100% { transform: scale(1); box-shadow: 0 0 0 0 rgba(11, 42, 74, 0); }
    }

    .check-btn-pulse {
      background: #f9a825; color: #4a2c00; border: 2px solid #e65100;
      padding: 0.7rem 1.6rem; border-radius: 40px;
      font-weight: 700; font-size: 0.9rem; cursor: pointer; margin-top: 0.8rem;
      transition: 0.2s;
      animation: pulse-complete 1.5s infinite;
      display: inline-flex;
      align-items: center;
      gap: 8px;
    }
    .check-btn-pulse:hover {
      background: #e65100;
      color: white;
      animation: none;
    }

    @keyframes pulse-complete {
      0% { transform: scale(1); box-shadow: 0 0 0 0 rgba(249, 168, 37, 0.7); }
      50% { transform: scale(1.03); box-shadow: 0 0 0 10px rgba(249, 168, 37, 0); }
      100% { transform: scale(1); box-shadow: 0 0 0 0 rgba(249, 168, 37, 0); }
    }

    .timer-hint-box {
      background: #fff3e0;
      border: 2px solid #e65100;
      border-radius: 12px;
      padding: 0.8rem 1.2rem;
      margin: 0.8rem 0 1rem 0;
      font-size: 0.95rem;
      font-weight: 700;
      color: #7a3300;
      display: flex;
      align-items: center;
      gap: 10px;
    }
    .timer-hint-box i {
      font-size: 1.2rem;
      color: #e65100;
    }

    .wheel-modal {
      display: none;
      position: fixed; top: 0; left: 0; right: 0; bottom: 0;
      background: rgba(0,0,0,0.7); z-index: 2000;
      align-items: center; justify-content: center;
    }
    .wheel-modal.show { display: flex; }
    .wheel-modal .wheel-content {
      background: white; border-radius: 24px;
      padding: 2rem 2.5rem; text-align: center;
      max-width: 500px; width: 90%;
      box-shadow: 0 20px 60px rgba(0,0,0,0.3);
    }
    .wheel-modal h3 { margin-top: 0; color: #0b2a4a; }
    .wheel-modal .wheel-display {
      font-size: 1.8rem; font-weight: 700;
      color: #2a6f97; margin: 1.5rem 0;
      min-height: 3.5rem;
      font-family: 'JetBrains Mono', monospace;
      line-height: 1.3;
    }
    .wheel-modal .wheel-display.spinning {
      color: #f9a825;
      animation: blink 0.2s infinite;
    }
    @keyframes blink { 0% { opacity: 1; } 50% { opacity: 0.4; } 100% { opacity: 1; } }
    .wheel-modal .wheel-close {
      background: #0b2a4a; color: white; border: none;
      padding: 0.6rem 1.6rem; border-radius: 30px;
      font-weight: 600; font-size: 0.9rem; cursor: pointer;
      margin-top: 0.5rem; margin-right: 0.5rem;
    }
    .wheel-modal .wheel-close:hover { background: #1f6390; }

    .truth-table {
      width: 100%; border-collapse: collapse; margin: 1rem 0;
      font-family: 'JetBrains Mono', 'Fira Code', monospace; font-size: 0.9rem;
    }
    .truth-table th {
      background: #0b2a4a; color: white; padding: 0.6rem;
      text-align: center; font-weight: 600;
    }
    .truth-table td {
      border: 2px solid #2a6f97; padding: 0.6rem;
      text-align: center; font-weight: 600; color: #0b2a4a;
      background: #f8fafc;
    }
    .truth-table td.answer {
      background: #fff8e1;
    }
    .truth-table select {
      padding: 0.3rem 0.5rem; border: 1.5px solid #d4e3f0;
      border-radius: 6px; font-family: inherit; font-size: 0.85rem;
      background: white; cursor: pointer;
    }
    .truth-table select.correct {
      border-color: #2d8f2d; background: #e8f5e9;
    }
    .truth-table select.incorrect {
      border-color: #e53935; background: #ffebee;
    }

    .parsons-wrapper {
      background: #f8fafc;
      border: 2px solid #2a6f97;
      border-radius: 20px;
      padding: 1.2rem 1.4rem;
      margin: 1.5rem 0;
    }
    .parsons-wrapper .parsons-header {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
      gap: 0.8rem;
      margin-bottom: 1rem;
    }
    .parsons-wrapper .parsons-header h3 {
      margin: 0;
      font-size: 1.1rem;
      color: #0b2a4a;
      display: flex;
      align-items: center;
      gap: 8px;
    }
    .parsons-wrapper .parsons-header h3 i { color: #2a6f97; }
    .parsons-wrapper .parsons-actions {
      display: flex;
      gap: 0.6rem;
      flex-wrap: wrap;
    }
    .parsons-wrapper .parsons-actions button {
      background: #0b2a4a;
      color: white;
      border: none;
      padding: 0.5rem 1.2rem;
      border-radius: 40px;
      font-weight: 600;
      font-size: 0.8rem;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      gap: 6px;
      transition: 0.2s;
    }
    .parsons-wrapper .parsons-actions button:hover {
      background: #1f6390;
      transform: translateY(-1px);
    }
    .parsons-wrapper .parsons-actions button.secondary {
      background: #eef6fc;
      color: #0b2a4a;
      border: 1.5px solid #b6cfe5;
    }
    .parsons-wrapper .parsons-actions button.secondary:hover {
      background: #dbeafe;
      border-color: #7bb3ff;
    }
    .parsons-container {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 1rem;
    }
    .parsons-container .parsons-column h4 {
      color: #0b2a4a;
      font-size: 0.95rem;
      margin-bottom: 0.5rem;
    }
    .parsons-container .parsons-items {
      background: #ffffff;
      border: 2px dashed #b6cfe5;
      border-radius: 12px;
      padding: 0.8rem;
      min-height: 250px;
    }
    .parsons-container .parsons-item {
      background: #eef6fc;
      border: 2px solid #b6cfe5;
      border-radius: 10px;
      padding: 0.5rem 0.9rem;
      margin-bottom: 0.4rem;
      cursor: grab;
      font-family: 'JetBrains Mono', monospace;
      font-size: 0.8rem;
      font-weight: 600;
      color: #0b2a4a;
      transition: 0.2s;
      user-select: none;
    }
    .parsons-container .parsons-item:hover {
      border-color: #2a6f97;
      background: #dbeafe;
      transform: translateX(4px);
    }
    .parsons-container .parsons-item.dragging {
      opacity: 0.5;
      transform: scale(0.98);
    }
    .parsons-container .parsons-drop {
      background: #fff8e1;
      border: 2px dashed #f9a825;
      border-radius: 12px;
      padding: 0.8rem;
      min-height: 250px;
    }
    .parsons-container .parsons-drop .placeholder {
      color: #b45309;
      font-style: italic;
      font-size: 0.85rem;
    }
    .parsons-feedback {
      font-weight: 600;
      margin-top: 0.8rem;
    }
    .parsons-feedback.ok { color: #2d8f2d; }
    .parsons-feedback.no { color: #b71c1c; }

    .parsons-answer-reveal {
      display: none;
      margin-top: 1.2rem;
      padding: 1.2rem 1.4rem;
      background: #e8f5e9;
      border-left: 5px solid #4caf50;
      border-radius: 12px;
    }
    .parsons-answer-reveal.show { display: block; }
    .parsons-answer-reveal h4 {
      color: #1b5e20;
      margin-top: 0;
      margin-bottom: 0.6rem;
    }
    .parsons-answer-reveal ol {
      margin: 0;
      padding-left: 1.6rem;
    }
    .parsons-answer-reveal ol li {
      font-family: 'JetBrains Mono', monospace;
      font-size: 0.85rem;
      color: #1b5e20;
      margin-bottom: 0.2rem;
    }

    .group-work {
      background: linear-gradient(135deg, #e3f2fd, #bbdefb);
      border: 2px solid #1e88e5; border-radius: 20px;
      padding: 1.4rem 1.8rem; margin: 1.5rem 0;
      display: flex; align-items: flex-start; gap: 1rem;
    }
    .group-work .badge {
      background: #1e88e5; color: white; font-weight: 700;
      font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.8px;
      padding: 0.3rem 0.9rem; border-radius: 30px; white-space: nowrap; flex-shrink: 0;
    }
    .group-work h3 { margin-top: 0; color: #0d47a1; font-size: 1.15rem; }
    .group-work p { margin-bottom: 0.3rem; color: #0d3b6e; }
    .group-work ul { margin: 0.5rem 0 0 0; padding-left: 1.2rem; }
    .group-work ul li { color: #0d3b6e; font-size: 0.9rem; }

    .plenary-box {
      background: linear-gradient(135deg, #e8f5e9, #c8e6c9);
      border: 2px solid #4caf50; border-radius: 20px;
      padding: 1.6rem 2rem; margin: 2rem 0;
    }
    .plenary-box h2 {
      border-left-color: #4caf50 !important;
      color: #1b5e20 !important;
      margin-top: 0 !important;
    }
    .plenary-box .plenary-question {
      background: white; border-radius: 14px;
      padding: 1rem 1.4rem; margin: 0.8rem 0;
      border-left: 4px solid #4caf50;
    }
    .plenary-box .plenary-question p {
      font-weight: 600; color: #1b5e20; margin-bottom: 0.4rem;
    }
    .plenary-box .plenary-question .answer {
      display: none; margin-top: 0.4rem; padding: 0.6rem 1rem;
      background: #e8f5e9; border-radius: 10px;
      font-size: 0.9rem; color: #1b5e20;
    }
    .plenary-box .plenary-question .answer.show { display: block; }
    .plenary-box .unlock-row {
      display: flex;
