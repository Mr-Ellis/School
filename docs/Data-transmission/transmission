        const div = document.createElement('div');
        div.className = 'parsons-item';
        div.draggable = true;
        div.textContent = line;
        div.setAttribute('data-line', line);
        div.addEventListener('dragstart', (e) => {
          draggedItem = div;
          div.classList.add('dragging');
          e.dataTransfer.setData('text/plain', line);
        });
        div.addEventListener('dragend', () => {
          div.classList.remove('dragging');
        });
        itemsContainer.appendChild(div);
      });
      dropZone.innerHTML = '<div class="placeholder">Drag the terms here to match the analogies...</div>';
      feedback.textContent = '';
    }

    dropZone.addEventListener('dragover', (e) => {
      e.preventDefault();
      dropZone.style.background = '#fff3e0';
    });

    dropZone.addEventListener('dragleave', () => {
      dropZone.style.background = '#fff8e1';
    });

    dropZone.addEventListener('drop', (e) => {
      e.preventDefault();
      dropZone.style.background = '#fff8e1';
      if (draggedItem) {
        const placeholder = dropZone.querySelector('.placeholder');
        if (placeholder) placeholder.remove();

        const clone = draggedItem.cloneNode(true);
        clone.draggable = false;
        clone.style.cursor = 'default';
        clone.style.marginBottom = '0.3rem';
        clone.classList.add('placed');
        dropZone.appendChild(clone);

        draggedItem.remove();
        draggedItem = null;
      }
    });

    checkBtn.addEventListener('click', () => {
      const placed = dropZone.querySelectorAll('.parsons-item');
      if (placed.length === 0) {
        feedback.textContent = '❌ No items placed yet.';
        feedback.className = 'parsons-feedback no';
        return;
      }
      if (placed.length !== correctOrder.length) {
        feedback.textContent = `⚠ You have placed ${placed.length} out of ${correctOrder.length} items. Keep going!`;
        feedback.className = 'parsons-feedback no';
        return;
      }

      let correct = 0;
      placed.forEach((item, index) => {
        const line = item.getAttribute('data-line');
        if (line === correctOrder[index]) {
          correct++;
          item.style.background = '#e8f5e9';
          item.style.borderColor = '#4caf50';
        } else {
          item.style.background = '#ffebee';
          item.style.borderColor = '#e53935';
        }
      });

      if (correct === correctOrder.length) {
        feedback.textContent = '✅ Perfect! All analogies matched correctly.';
        feedback.className = 'parsons-feedback ok';
        playMidiTune();
      } else {
        feedback.textContent = `${correct} out of ${correctOrder.length} items in the correct position. Green = correct, red = wrong.`;
        feedback.className = 'parsons-feedback no';
      }
    });

    resetBtn.addEventListener('click', renderItems);

    renderItems();
  })();

  // ===== RANDOM WHEEL =====
  function openWheel() {
    document.getElementById('wheelModal').classList.add('show');
    spinWheel();
  }

  function closeWheel() {
    document.getElementById('wheelModal').classList.remove('show');
    document.getElementById('wheelDisplay').classList.remove('spinning');
  }

  function spinWheel() {
    const display = document.getElementById('wheelDisplay');
    display.classList.add('spinning');
    let count = 0;
    const maxSpins = 25;

    const spinInterval = setInterval(() => {
      const randomIndex = Math.floor(Math.random() * studentNames.length);
      display.textContent = studentNames[randomIndex];
      count++;

      if (count >= maxSpins) {
        clearInterval(spinInterval);
        display.classList.remove('spinning');
      }
    }, 80);
  }
</script>

